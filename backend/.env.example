# ─── Server ────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── AI APIs ───────────────────────────────────────────────
# Get free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...your-key-here...

# ─── Instagram / Meta ──────────────────────────────────────
# Your app must have: instagram_basic, instagram_content_publish, pages_show_list
# Get long-lived token from Meta Graph API Explorer
# PUBLIC_URL must be a reachable HTTPS URL so Instagram can fetch your video files.
# For local dev use ngrok: ngrok http 3001  → paste the https URL here
PUBLIC_URL=https://your-domain.com

# ─── Storage ───────────────────────────────────────────────
DB_PATH=./data/instagram_manager.db
UPLOAD_DIR=./uploads

# ─── How to get Instagram credentials ─────────────────────
# 1. Create a Facebook Developer App at developers.facebook.com
# 2. Add the Instagram Graph API product
# 3. Connect a Facebook Page linked to an Instagram Business/Creator Account
# 4. Use Graph API Explorer to get a Page Access Token with these permissions:
#      instagram_basic, instagram_content_publish, pages_show_list
# 5. Exchange for a Long-Lived Token (60-day expiry) via:
#    GET https://graph.facebook.com/v19.0/oauth/access_token
#       ?grant_type=fb_exchange_token
#       &client_id={app-id}
#       &client_secret={app-secret}
#       &fb_exchange_token={short-lived-token}
# 6. Get your IG User ID:
#    GET https://graph.facebook.com/v19.0/me/accounts?access_token={page-token}
#    Then: GET https://graph.facebook.com/v19.0/{page-id}?fields=instagram_business_account&access_token={token}
